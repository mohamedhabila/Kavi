  "cases": [
    {
      "id": "profile-correction-chitchat",
      "title": "A current home city replaces an older city without losing history",
      "controlKind": "mixed",
      "families": [
        "durable_profile",
        "correction_and_supersession",
        "temporal_reasoning",
        "cross_mode_transfer",
        "memory_safety"
      ],
      "modeTransitions": ["chitchat_to_chitchat"],
      "fixtures": [],
      "steps": [
        {
          "id": "learn-city",
          "kind": "user_turn",
          "at": "2026-01-03T09:00:00.000Z",
          "mode": "forced_chitchat",
          "message": "I moved to Rotterdam last month. That is my current home city."
        },
        {
          "id": "correct-city",
          "kind": "user_turn",
          "at": "2026-02-10T18:00:00.000Z",
          "mode": "forced_chitchat",
          "message": "Correction: I live in Utrecht now, not Rotterdam."
        },
        {
          "id": "probe-city",
          "kind": "user_turn",
          "at": "2026-03-02T12:00:00.000Z",
          "mode": "forced_chitchat",
          "message": "Which city do I currently live in?"
        }
      ],
      "assertions": [
        {
          "id": "city-mode",
          "afterStepId": "probe-city",
          "target": "turn.probe-city.actual-mode",
          "operator": "equals",
          "expected": "chitchat"
        },
        {
          "id": "city-current",
          "afterStepId": "probe-city",
          "target": "memory.fact.global.self.home-city.current-object",
          "operator": "equals",
          "expected": "Utrecht"
        },
        {
          "id": "city-history",
          "afterStepId": "probe-city",
          "target": "memory.fact.global.self.home-city.historical-objects",
          "operator": "contains",
          "expected": "Rotterdam"
        },
        {
          "id": "city-grounding",
          "afterStepId": "probe-city",
          "target": "turn.probe-city.memory-refs",
          "operator": "contains",
          "expected": "self-home-city-current"
        }
      ],
      "metricIds": [
        "pass_at_1",
        "memory_write",
        "memory_retrieval",
        "memory_utilization",
        "false_memory_rate"
      ]
    },
    {
      "id": "preference-to-calendar-action",
      "title": "A conversational scheduling preference shapes a later calendar action",
      "controlKind": "positive",
      "families": ["preference_application", "cross_mode_transfer"],
      "modeTransitions": ["chitchat_to_agentic"],
      "fixtures": [
        {
          "id": "morning-slot",
          "target": "native.calendar.availability.2026-08-12-09-00",
          "value": true
        },
        {
          "id": "afternoon-slot",
          "target": "native.calendar.availability.2026-08-12-15-00",
          "value": true
        }
      ],
      "steps": [
        {
          "id": "learn-schedule",
          "kind": "user_turn",
          "at": "2026-04-01T08:00:00.000Z",
          "mode": "forced_chitchat",
          "message": "When there is a choice, I prefer appointments before 10 in the morning."
        },
        {
          "id": "schedule-check-in",
          "kind": "user_turn",
          "at": "2026-04-20T10:00:00.000Z",
          "mode": "forced_agentic",
          "message": "Schedule a 30-minute check-in on August 12 using one of my available times."
        }
      ],
      "assertions": [
        {
          "id": "schedule-mode",
          "afterStepId": "schedule-check-in",
          "target": "turn.schedule-check-in.actual-mode",
          "operator": "equals",
          "expected": "agentic"
        },
        {
          "id": "schedule-memory",
          "afterStepId": "schedule-check-in",
          "target": "turn.schedule-check-in.memory-refs",
          "operator": "contains",
          "expected": "self-morning-appointments"
        },
        {
          "id": "schedule-hour",
          "afterStepId": "schedule-check-in",
          "target": "native.calendar.event.check-in.start-hour",
          "operator": "equals",
          "expected": 9
        },
        {
          "id": "schedule-duration",
          "afterStepId": "schedule-check-in",
          "target": "native.calendar.event.check-in.duration-minutes",
          "operator": "equals",
          "expected": 30
        }
      ],
      "metricIds": [
        "pass_at_1",
        "task_understanding",
        "task_completion",
        "memory_retrieval",
        "memory_utilization"
      ]
    },
