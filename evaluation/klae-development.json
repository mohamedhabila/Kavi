    {
      "id": "failure-gotcha-reuse",
      "title": "A recovered read-only failure is avoided on the next similar task",
      "controlKind": "mixed",
      "families": ["procedure_learning", "failure_learning", "cross_mode_transfer"],
      "modeTransitions": ["agentic_to_agentic"],
      "fixtures": [
        {
          "id": "archive-read-only",
          "target": "workspace.policy.archive.writable",
          "value": false
        },
        {
          "id": "drafts-writable",
          "target": "workspace.policy.drafts.writable",
          "value": true
        }
      ],
      "steps": [
        {
          "id": "first-note",
          "kind": "user_turn",
          "at": "2026-06-01T09:00:00.000Z",
          "mode": "forced_agentic",
          "message": "Save a short Valencia handoff note under archive. If that location fails, recover safely and finish the task."
        },
        {
          "id": "second-note",
          "kind": "user_turn",
          "at": "2026-06-15T09:00:00.000Z",
          "mode": "forced_agentic",
          "message": "Prepare the same kind of handoff note for Porto."
        }
      ],
      "assertions": [
        {
          "id": "gotcha-recorded",
          "afterStepId": "second-note",
          "target": "memory.experience.archive-write.failure-codes",
          "operator": "contains",
          "expected": "read-only-directory"
        },
        {
          "id": "first-recovered",
          "afterStepId": "second-note",
          "target": "workspace.file.drafts-valencia-handoff.exists",
          "operator": "equals",
          "expected": true
        },
        {
          "id": "second-completed",
          "afterStepId": "second-note",
          "target": "workspace.file.drafts-porto-handoff.exists",
          "operator": "equals",
          "expected": true
        },
        {
          "id": "gotcha-reused",
          "afterStepId": "second-note",
          "target": "run.porto-handoff.write-targets",
          "operator": "not_contains",
          "expected": "archive"
        }
      ],
      "metricIds": [
        "pass_at_1",
        "task_understanding",
        "task_completion",
        "memory_retrieval",
        "memory_utilization"
      ]
    },
